<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="5dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/item_task_checkbox_dark"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_checkbox_unchecked"
        android:contentDescription="@string/task_checkbox" />

    <TextView
        android:id="@+id/item_task_text_view_dark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:paddingVertical="5dp"
        android:text="@string/task_placeholder"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
